{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": ".vercel/output/functions",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["api/**/*", "server/**/*"],
  "exclude": ["node_modules", "dist", "src"]
}
