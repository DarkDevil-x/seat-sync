# ── MongoDB ──────────────────────────────────────────────────────────────────
# Atlas: mongodb+srv://<user>:<pass>@cluster0.mongodb.net/seat-sync?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/seat-sync
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/seat-sync?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=replace-this-with-a-long-random-secret

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Set to your frontend URL in production; defaults to * if unset
ALLOWED_ORIGIN=http://localhost:5173

# ── Groq AI (admin event description generation) ─────────────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=
